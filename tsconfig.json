{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "lib": ["ES2022"],
    "strict": true, "esModuleInterop": true, "outDir": "dist", "rootDir": ".",
    "sourceMap": true, "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
