{
  "name": "orbit-git",
  "displayName": "Orbit Git",
  "description": "Commit graph, multi-commit comparison, selection history and grouped Git operations for VS Code, Cursor and Qoder.",
  "version": "0.15.0",
  "publisher": "PRCooper",
  "repository": {
    "type": "git",
    "url": "https://github.com/cpr117/git-workbench.git"
  },
  "homepage": "https://github.com/cpr117/git-workbench",
  "bugs": {
    "url": "https://github.com/cpr117/git-workbench/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "graph",
    "history",
    "blame",
    "cursor"
  ],
  "main": "./dist/src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Git commands and repository hooks require a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "compile": "npm run clean && tsc -p .",
    "check": "tsc -p . --noEmit",
    "test": "npm run compile && node --test dist/test/*.test.js",
    "build:native": "node scripts/build-native.mjs",
    "package": "npm run compile && npm run build:native && vsce package --no-dependencies --allow-missing-repository -o ../orbit-git-0.15.0.vsix",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "vscode:prepublish": "npm run compile"
  },
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "git-workbench-panel",
          "title": "Git",
          "icon": "media/git.svg"
        }
      ]
    },
    "views": {
      "git-workbench-panel": [
        {
          "id": "gitWorkbench.log",
          "name": "Git Log",
          "type": "webview",
          "contextualTitle": "Orbit Git",
          "when": "config.gitWorkbench.modules.graph || config.gitWorkbench.modules.stash"
        }
      ],
      "scm": [
        {
          "id": "gitWorkbench.compareFiles",
          "name": "%contributes.views.scm.0.name%",
          "contextualTitle": "%contributes.views.scm.0.contextualTitle%",
          "icon": "media/git.svg",
          "visibility": "collapsed",
          "when": "gitWorkbench.comparisonActive && config.gitWorkbench.modules.comparison"
        }
      ]
    },
    "configuration": {
      "title": "Orbit Git",
      "properties": {
        "gitWorkbench.historyPresentation": {
          "type": "string",
          "enum": [
            "popup",
            "editor"
          ],
          "default": "popup",
          "enumDescriptions": [
            "%contributes.configuration.properties.gitWorkbench.historyPresentation.enumDescriptions.0%",
            "%contributes.configuration.properties.gitWorkbench.historyPresentation.enumDescriptions.1%"
          ],
          "description": "%contributes.configuration.properties.gitWorkbench.historyPresentation.description%"
        },
        "gitWorkbench.comparisonViewMode": {
          "type": "string",
          "enum": [
            "tree",
            "list"
          ],
          "default": "tree",
          "enumDescriptions": [
            "%contributes.configuration.properties.gitWorkbench.comparisonViewMode.enumDescriptions.0%",
            "%contributes.configuration.properties.gitWorkbench.comparisonViewMode.enumDescriptions.1%"
          ],
          "description": "%contributes.configuration.properties.gitWorkbench.comparisonViewMode.description%"
        },
        "gitWorkbench.comparisonSortOrder": {
          "type": "string",
          "enum": [
            "path",
            "name",
            "status"
          ],
          "default": "path",
          "enumDescriptions": [
            "%contributes.configuration.properties.gitWorkbench.comparisonSortOrder.enumDescriptions.0%",
            "%contributes.configuration.properties.gitWorkbench.comparisonSortOrder.enumDescriptions.1%",
            "%contributes.configuration.properties.gitWorkbench.comparisonSortOrder.enumDescriptions.2%"
          ],
          "description": "%contributes.configuration.properties.gitWorkbench.comparisonSortOrder.description%"
        },
        "gitWorkbench.comparisonIconStyle": {
          "type": "string",
          "enum": [
            "file",
            "status"
          ],
          "default": "file",
          "enumDescriptions": [
            "%contributes.configuration.properties.gitWorkbench.comparisonIconStyle.enumDescriptions.0%",
            "%contributes.configuration.properties.gitWorkbench.comparisonIconStyle.enumDescriptions.1%"
          ],
          "description": "%contributes.configuration.properties.gitWorkbench.comparisonIconStyle.description%"
        },
        "gitWorkbench.modules": {
          "type": "object",
          "scope": "window",
          "order": 0,
          "additionalProperties": false,
          "default": {
            "graph": true,
            "selectionHistory": true,
            "fileHistory": true,
            "blame": true,
            "comparison": true,
            "stash": true,
            "operations": true,
            "explorerMenu": true,
            "editorMenu": true,
            "statusBar": true
          },
          "description": "%modules.description%",
          "properties": {
            "graph": {
              "type": "boolean",
              "default": true,
              "description": "%modules.graph.label%"
            },
            "selectionHistory": {
              "type": "boolean",
              "default": true,
              "description": "%modules.selectionHistory.label%"
            },
            "fileHistory": {
              "type": "boolean",
              "default": true,
              "description": "%modules.fileHistory.label%"
            },
            "blame": {
              "type": "boolean",
              "default": true,
              "description": "%modules.blame.label%"
            },
            "comparison": {
              "type": "boolean",
              "default": true,
              "description": "%modules.comparison.label%"
            },
            "stash": {
              "type": "boolean",
              "default": true,
              "description": "%modules.stash.label%"
            },
            "operations": {
              "type": "boolean",
              "default": true,
              "description": "%modules.operations.label%"
            },
            "explorerMenu": {
              "type": "boolean",
              "default": true,
              "description": "%modules.explorerMenu.label%"
            },
            "editorMenu": {
              "type": "boolean",
              "default": true,
              "description": "%modules.editorMenu.label%"
            },
            "statusBar": {
              "type": "boolean",
              "default": true,
              "description": "%modules.statusBar.label%"
            }
          }
        }
      }
    },
    "commands": [
      {
        "command": "gitWorkbench.menu",
        "title": "%contributes.commands.0.title%",
        "category": "Orbit Git"
      },
      {
        "command": "gitWorkbench.open",
        "title": "%contributes.commands.1.title%",
        "category": "Orbit Git",
        "icon": "$(git-merge)",
        "enablement": "(config.gitWorkbench.modules.graph || config.gitWorkbench.modules.stash)"
      },
      {
        "command": "gitWorkbench.selectionHistory",
        "title": "%contributes.commands.2.title%",
        "category": "Orbit Git",
        "enablement": "config.gitWorkbench.modules.selectionHistory"
      },
      {
        "command": "gitWorkbench.fileHistory",
        "title": "%contributes.commands.3.title%",
        "category": "Orbit Git",
        "enablement": "config.gitWorkbench.modules.fileHistory"
      },
      {
        "command": "gitWorkbench.blame",
        "title": "%contributes.commands.4.title%",
        "category": "Orbit Git",
        "enablement": "config.gitWorkbench.modules.blame"
      },
      {
        "command": "gitWorkbench.toggleBlame",
        "title": "%contributes.commands.5.title%",
        "category": "Orbit Git",
        "enablement": "config.gitWorkbench.modules.blame"
      },
      {
        "command": "gitWorkbench.operations",
        "title": "%contributes.commands.6.title%",
        "category": "Orbit Git",
        "enablement": "config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.stageSelection",
        "title": "%contributes.commands.7.title%",
        "category": "Orbit Git",
        "enablement": "config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.explorer.commit",
        "title": "%contributes.commands.8.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.explorer.add",
        "title": "%contributes.commands.9.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.explorer.exclude",
        "title": "%contributes.commands.10.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.explorer.diff",
        "title": "%contributes.commands.11.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.comparison"
      },
      {
        "command": "gitWorkbench.explorer.compareRevision",
        "title": "%contributes.commands.12.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.comparison"
      },
      {
        "command": "gitWorkbench.explorer.compareBranch",
        "title": "%contributes.commands.13.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.comparison"
      },
      {
        "command": "gitWorkbench.explorer.history",
        "title": "%contributes.commands.14.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.graph"
      },
      {
        "command": "gitWorkbench.explorer.rollback",
        "title": "%contributes.commands.15.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.explorer.push",
        "title": "Push…",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.explorer.pull",
        "title": "%contributes.commands.17.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.explorer.fetch",
        "title": "Fetch…",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.explorer.merge",
        "title": "Merge…",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.explorer.rebase",
        "title": "Rebase…",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.explorer.branches",
        "title": "%contributes.commands.21.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.explorer.newBranch",
        "title": "%contributes.commands.22.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.explorer.newTag",
        "title": "%contributes.commands.23.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.explorer.reset",
        "title": "Reset HEAD…",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.explorer.stash",
        "title": "%contributes.commands.25.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations && config.gitWorkbench.modules.stash"
      },
      {
        "command": "gitWorkbench.explorer.unstash",
        "title": "%contributes.commands.26.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations && config.gitWorkbench.modules.stash"
      },
      {
        "command": "gitWorkbench.explorer.remotes",
        "title": "%contributes.commands.27.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.explorer.clone",
        "title": "Clone…",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.compare.refresh",
        "title": "%contributes.commands.29.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.comparison",
        "icon": "$(refresh)"
      },
      {
        "command": "gitWorkbench.compare.search",
        "title": "%contributes.commands.30.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.comparison",
        "icon": "$(search)"
      },
      {
        "command": "gitWorkbench.compare.select",
        "title": "%contributes.commands.31.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.comparison"
      },
      {
        "command": "gitWorkbench.compare.viewTree",
        "title": "%contributes.commands.32.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && gitWorkbench.comparisonViewMode != tree && config.gitWorkbench.modules.comparison"
      },
      {
        "command": "gitWorkbench.compare.viewList",
        "title": "%contributes.commands.33.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && gitWorkbench.comparisonViewMode != list && config.gitWorkbench.modules.comparison"
      },
      {
        "command": "gitWorkbench.compare.sort.name",
        "title": "%contributes.commands.34.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && gitWorkbench.comparisonSortOrder != name && config.gitWorkbench.modules.comparison"
      },
      {
        "command": "gitWorkbench.compare.sort.path",
        "title": "%contributes.commands.35.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && gitWorkbench.comparisonSortOrder != path && config.gitWorkbench.modules.comparison"
      },
      {
        "command": "gitWorkbench.compare.sort.status",
        "title": "%contributes.commands.36.title%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && gitWorkbench.comparisonSortOrder != status && config.gitWorkbench.modules.comparison"
      },
      {
        "command": "gitWorkbench.compare.close",
        "title": "%contributes.commands.37.title%",
        "category": "Orbit Git",
        "enablement": "gitWorkbench.comparisonActive"
      },
      {
        "command": "gitWorkbench.compare.icons.file",
        "title": "%comparison.icons.file%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && gitWorkbench.comparisonIconStyle != file && config.gitWorkbench.modules.comparison"
      },
      {
        "command": "gitWorkbench.compare.icons.status",
        "title": "%comparison.icons.status%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && gitWorkbench.comparisonIconStyle != status && config.gitWorkbench.modules.comparison"
      },
      {
        "command": "gitWorkbench.explorer.file.commit",
        "title": "%explorer.file.commit%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.explorer.file.rollback",
        "title": "%explorer.file.rollback%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
      },
      {
        "command": "gitWorkbench.explorer.file.stash",
        "title": "%explorer.file.stash%",
        "category": "Orbit Git",
        "enablement": "isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations && config.gitWorkbench.modules.stash"
      },
      {
        "command": "gitWorkbench.modules",
        "title": "%modules.title%",
        "category": "Orbit Git",
        "icon": "$(settings-gear)"
      }
    ],
    "submenus": [
      {
        "id": "gitWorkbench.editorMenu",
        "label": "Orbit Git"
      },
      {
        "id": "gitWorkbench.explorerMenu",
        "label": "Orbit Git"
      },
      {
        "id": "gitWorkbench.directoryMenu",
        "label": "Orbit Git"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "gitWorkbench.editorMenu",
          "when": "resourceScheme == file && isWorkspaceTrusted && config.gitWorkbench.modules.editorMenu && (config.gitWorkbench.modules.selectionHistory || config.gitWorkbench.modules.fileHistory || config.gitWorkbench.modules.blame || config.gitWorkbench.modules.graph || config.gitWorkbench.modules.stash || config.gitWorkbench.modules.operations)",
          "group": "gitWorkbench"
        }
      ],
      "explorer/context": [
        {
          "submenu": "gitWorkbench.explorerMenu",
          "when": "resourceScheme == file && !explorerResourceIsFolder && isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu",
          "group": "gitWorkbench"
        },
        {
          "submenu": "gitWorkbench.directoryMenu",
          "when": "resourceScheme == file && explorerResourceIsFolder && isWorkspaceTrusted && config.gitWorkbench.modules.explorerMenu",
          "group": "gitWorkbench"
        }
      ],
      "gitWorkbench.editorMenu": [
        {
          "command": "gitWorkbench.selectionHistory",
          "group": "1_history@1",
          "when": "config.gitWorkbench.modules.selectionHistory"
        },
        {
          "command": "gitWorkbench.fileHistory",
          "group": "1_history@2",
          "when": "config.gitWorkbench.modules.fileHistory"
        },
        {
          "command": "gitWorkbench.blame",
          "group": "1_history@3",
          "when": "config.gitWorkbench.modules.blame"
        },
        {
          "command": "gitWorkbench.toggleBlame",
          "group": "1_history@4",
          "when": "config.gitWorkbench.modules.blame"
        },
        {
          "command": "gitWorkbench.stageSelection",
          "when": "editorHasSelection && config.gitWorkbench.modules.operations",
          "group": "2_commit"
        },
        {
          "command": "gitWorkbench.open",
          "group": "3_repository@1",
          "when": "(config.gitWorkbench.modules.graph || config.gitWorkbench.modules.stash)"
        },
        {
          "command": "gitWorkbench.operations",
          "group": "3_repository@2",
          "when": "config.gitWorkbench.modules.operations"
        }
      ],
      "gitWorkbench.explorerMenu": [
        {
          "command": "gitWorkbench.explorer.file.commit",
          "group": "1_commit@1",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        },
        {
          "command": "gitWorkbench.explorer.add",
          "group": "1_commit@2",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        },
        {
          "command": "gitWorkbench.explorer.exclude",
          "group": "1_commit@3",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        },
        {
          "command": "gitWorkbench.explorer.diff",
          "group": "2_history@1",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.comparison"
        },
        {
          "command": "gitWorkbench.explorer.compareRevision",
          "group": "2_history@2",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.comparison"
        },
        {
          "command": "gitWorkbench.explorer.compareBranch",
          "group": "2_history@3",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.comparison"
        },
        {
          "command": "gitWorkbench.fileHistory",
          "group": "2_history@4",
          "when": "config.gitWorkbench.modules.fileHistory"
        },
        {
          "command": "gitWorkbench.explorer.file.rollback",
          "group": "2_history@5",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        },
        {
          "command": "gitWorkbench.explorer.file.stash",
          "group": "3_stash@1",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations && config.gitWorkbench.modules.stash"
        },
        {
          "command": "gitWorkbench.explorer.unstash",
          "group": "3_stash@2",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations && config.gitWorkbench.modules.stash"
        },
        {
          "command": "gitWorkbench.open",
          "group": "4_repository@1",
          "when": "(config.gitWorkbench.modules.graph || config.gitWorkbench.modules.stash)"
        },
        {
          "command": "gitWorkbench.operations",
          "group": "4_repository@2",
          "when": "config.gitWorkbench.modules.operations"
        }
      ],
      "commandPalette": [
        {
          "command": "gitWorkbench.menu",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "gitWorkbench.open",
          "when": "false"
        },
        {
          "command": "gitWorkbench.selectionHistory",
          "when": "false"
        },
        {
          "command": "gitWorkbench.fileHistory",
          "when": "false"
        },
        {
          "command": "gitWorkbench.blame",
          "when": "false"
        },
        {
          "command": "gitWorkbench.toggleBlame",
          "when": "false"
        },
        {
          "command": "gitWorkbench.operations",
          "when": "false"
        },
        {
          "command": "gitWorkbench.stageSelection",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.commit",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.add",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.exclude",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.diff",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.compareRevision",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.compareBranch",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.history",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.rollback",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.push",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.pull",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.fetch",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.merge",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.rebase",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.branches",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.newBranch",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.newTag",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.reset",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.stash",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.unstash",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.remotes",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.clone",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.refresh",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.search",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.select",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.viewTree",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.viewList",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.sort.name",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.sort.path",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.sort.status",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.close",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.icons.file",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.icons.status",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.file.commit",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.file.rollback",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.file.stash",
          "when": "false"
        },
        {
          "command": "gitWorkbench.modules",
          "when": "false"
        }
      ],
      "scm/title": [
        {
          "command": "gitWorkbench.open",
          "group": "navigation",
          "when": "(config.gitWorkbench.modules.graph || config.gitWorkbench.modules.stash)"
        }
      ],
      "gitWorkbench.directoryMenu": [
        {
          "command": "gitWorkbench.explorer.commit",
          "group": "1_commit@1",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        },
        {
          "command": "gitWorkbench.explorer.add",
          "group": "1_commit@2",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        },
        {
          "command": "gitWorkbench.explorer.exclude",
          "group": "1_commit@3",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        },
        {
          "command": "gitWorkbench.explorer.diff",
          "group": "2_history@1",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.comparison"
        },
        {
          "command": "gitWorkbench.explorer.compareRevision",
          "group": "2_history@2",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.comparison"
        },
        {
          "command": "gitWorkbench.explorer.compareBranch",
          "group": "2_history@3",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.comparison"
        },
        {
          "command": "gitWorkbench.explorer.history",
          "group": "2_history@4",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.graph"
        },
        {
          "command": "gitWorkbench.explorer.rollback",
          "group": "2_history@5",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        },
        {
          "command": "gitWorkbench.explorer.push",
          "group": "3_sync@1",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        },
        {
          "command": "gitWorkbench.explorer.pull",
          "group": "3_sync@2",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        },
        {
          "command": "gitWorkbench.explorer.fetch",
          "group": "3_sync@3",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        },
        {
          "command": "gitWorkbench.explorer.merge",
          "group": "4_integrate@1",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        },
        {
          "command": "gitWorkbench.explorer.rebase",
          "group": "4_integrate@2",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        },
        {
          "command": "gitWorkbench.explorer.branches",
          "group": "5_refs@1",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        },
        {
          "command": "gitWorkbench.explorer.newBranch",
          "group": "5_refs@2",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        },
        {
          "command": "gitWorkbench.explorer.newTag",
          "group": "5_refs@3",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        },
        {
          "command": "gitWorkbench.explorer.reset",
          "group": "5_refs@4",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        },
        {
          "command": "gitWorkbench.explorer.stash",
          "group": "6_stash@1",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations && config.gitWorkbench.modules.stash"
        },
        {
          "command": "gitWorkbench.explorer.unstash",
          "group": "6_stash@2",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations && config.gitWorkbench.modules.stash"
        },
        {
          "command": "gitWorkbench.explorer.remotes",
          "group": "7_tools@1",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        },
        {
          "command": "gitWorkbench.explorer.clone",
          "group": "7_tools@2",
          "when": "config.gitWorkbench.modules.explorerMenu && config.gitWorkbench.modules.operations"
        }
      ],
      "view/title": [
        {
          "command": "gitWorkbench.compare.search",
          "when": "view == gitWorkbench.compareFiles && config.gitWorkbench.modules.comparison",
          "group": "navigation@1"
        },
        {
          "command": "gitWorkbench.compare.refresh",
          "when": "view == gitWorkbench.compareFiles && config.gitWorkbench.modules.comparison",
          "group": "navigation@2"
        },
        {
          "command": "gitWorkbench.compare.viewTree",
          "when": "view == gitWorkbench.compareFiles && config.gitWorkbench.modules.comparison",
          "group": "1_view@1"
        },
        {
          "command": "gitWorkbench.compare.viewList",
          "when": "view == gitWorkbench.compareFiles && config.gitWorkbench.modules.comparison",
          "group": "1_view@2"
        },
        {
          "command": "gitWorkbench.compare.sort.name",
          "when": "view == gitWorkbench.compareFiles && config.gitWorkbench.modules.comparison",
          "group": "2_sort@1"
        },
        {
          "command": "gitWorkbench.compare.sort.path",
          "when": "view == gitWorkbench.compareFiles && config.gitWorkbench.modules.comparison",
          "group": "2_sort@2"
        },
        {
          "command": "gitWorkbench.compare.sort.status",
          "when": "view == gitWorkbench.compareFiles && config.gitWorkbench.modules.comparison",
          "group": "2_sort@3"
        },
        {
          "command": "gitWorkbench.compare.icons.file",
          "when": "view == gitWorkbench.compareFiles && config.gitWorkbench.modules.comparison",
          "group": "2_icons@1"
        },
        {
          "command": "gitWorkbench.compare.icons.status",
          "when": "view == gitWorkbench.compareFiles && config.gitWorkbench.modules.comparison",
          "group": "2_icons@2"
        },
        {
          "command": "gitWorkbench.compare.close",
          "when": "view == gitWorkbench.compareFiles",
          "group": "3_comparison@1"
        },
        {
          "command": "gitWorkbench.modules",
          "when": "view == gitWorkbench.log",
          "group": "navigation@9"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gitWorkbench.open",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      }
    ],
    "viewsWelcome": [
      {
        "view": "gitWorkbench.compareFiles",
        "contents": "%contributes.viewsWelcome.0.contents%"
      }
    ]
  },
