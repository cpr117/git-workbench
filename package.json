{
  "name": "git-workbench",
  "displayName": "Git Workbench",
  "description": "Commit graph, multi-commit comparison, selection history and grouped Git operations for VS Code, Cursor and Qoder.",
  "version": "0.14.0",
  "publisher": "local-tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/cpr117/git-workbench.git"
  },
  "homepage": "https://github.com/cpr117/git-workbench",
  "bugs": {
    "url": "https://github.com/cpr117/git-workbench/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "graph",
    "history",
    "blame",
    "cursor"
  ],
  "main": "./dist/src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Git commands and repository hooks require a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "compile": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "test": "npm run compile && node --test dist/test/*.test.js",
    "build:native": "node scripts/build-native.mjs",
    "package": "npm run compile && npm run build:native && vsce package --no-dependencies --allow-missing-repository -o ../git-workbench-0.14.0.vsix"
  },
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "git-workbench-panel",
          "title": "Git",
          "icon": "media/git.svg"
        }
      ]
    },
    "views": {
      "git-workbench-panel": [
        {
          "id": "gitWorkbench.log",
          "name": "Git Log",
          "type": "webview",
          "contextualTitle": "Git Workbench"
        }
      ],
      "scm": [
        {
          "id": "gitWorkbench.compareFiles",
          "name": "%contributes.views.scm.0.name%",
          "contextualTitle": "%contributes.views.scm.0.contextualTitle%",
          "icon": "media/git.svg",
          "visibility": "collapsed",
          "when": "gitWorkbench.comparisonActive"
        }
      ]
    },
    "configuration": {
      "title": "Git Workbench",
      "properties": {
        "gitWorkbench.historyPresentation": {
          "type": "string",
          "enum": [
            "popup",
            "editor"
          ],
          "default": "popup",
          "enumDescriptions": [
            "%contributes.configuration.properties.gitWorkbench.historyPresentation.enumDescriptions.0%",
            "%contributes.configuration.properties.gitWorkbench.historyPresentation.enumDescriptions.1%"
          ],
          "description": "%contributes.configuration.properties.gitWorkbench.historyPresentation.description%"
        },
        "gitWorkbench.comparisonViewMode": {
          "type": "string",
          "enum": [
            "tree",
            "list"
          ],
          "default": "tree",
          "enumDescriptions": [
            "%contributes.configuration.properties.gitWorkbench.comparisonViewMode.enumDescriptions.0%",
            "%contributes.configuration.properties.gitWorkbench.comparisonViewMode.enumDescriptions.1%"
          ],
          "description": "%contributes.configuration.properties.gitWorkbench.comparisonViewMode.description%"
        },
        "gitWorkbench.comparisonSortOrder": {
          "type": "string",
          "enum": [
            "path",
            "name",
            "status"
          ],
          "default": "path",
          "enumDescriptions": [
            "%contributes.configuration.properties.gitWorkbench.comparisonSortOrder.enumDescriptions.0%",
            "%contributes.configuration.properties.gitWorkbench.comparisonSortOrder.enumDescriptions.1%",
            "%contributes.configuration.properties.gitWorkbench.comparisonSortOrder.enumDescriptions.2%"
          ],
          "description": "%contributes.configuration.properties.gitWorkbench.comparisonSortOrder.description%"
        },
        "gitWorkbench.comparisonIconStyle": {
          "type": "string",
          "enum": [
            "file",
            "status"
          ],
          "default": "file",
          "enumDescriptions": [
            "%contributes.configuration.properties.gitWorkbench.comparisonIconStyle.enumDescriptions.0%",
            "%contributes.configuration.properties.gitWorkbench.comparisonIconStyle.enumDescriptions.1%"
          ],
          "description": "%contributes.configuration.properties.gitWorkbench.comparisonIconStyle.description%"
        }
      }
    },
    "commands": [
      {
        "command": "gitWorkbench.menu",
        "title": "%contributes.commands.0.title%",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.open",
        "title": "%contributes.commands.1.title%",
        "category": "Git Workbench",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitWorkbench.selectionHistory",
        "title": "%contributes.commands.2.title%",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.fileHistory",
        "title": "%contributes.commands.3.title%",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.blame",
        "title": "%contributes.commands.4.title%",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.toggleBlame",
        "title": "%contributes.commands.5.title%",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.operations",
        "title": "%contributes.commands.6.title%",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.stageSelection",
        "title": "%contributes.commands.7.title%",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.explorer.commit",
        "title": "%contributes.commands.8.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.add",
        "title": "%contributes.commands.9.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.exclude",
        "title": "%contributes.commands.10.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.diff",
        "title": "%contributes.commands.11.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.compareRevision",
        "title": "%contributes.commands.12.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.compareBranch",
        "title": "%contributes.commands.13.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.history",
        "title": "%contributes.commands.14.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.rollback",
        "title": "%contributes.commands.15.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.push",
        "title": "Push…",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.pull",
        "title": "%contributes.commands.17.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.fetch",
        "title": "Fetch…",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.merge",
        "title": "Merge…",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.rebase",
        "title": "Rebase…",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.branches",
        "title": "%contributes.commands.21.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.newBranch",
        "title": "%contributes.commands.22.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.newTag",
        "title": "%contributes.commands.23.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.reset",
        "title": "Reset HEAD…",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.stash",
        "title": "%contributes.commands.25.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.unstash",
        "title": "%contributes.commands.26.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.remotes",
        "title": "%contributes.commands.27.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.explorer.clone",
        "title": "Clone…",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.compare.refresh",
        "title": "%contributes.commands.29.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted",
        "icon": "$(refresh)"
      },
      {
        "command": "gitWorkbench.compare.search",
        "title": "%contributes.commands.30.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted",
        "icon": "$(search)"
      },
      {
        "command": "gitWorkbench.compare.select",
        "title": "%contributes.commands.31.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "gitWorkbench.compare.viewTree",
        "title": "%contributes.commands.32.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted && gitWorkbench.comparisonViewMode != tree"
      },
      {
        "command": "gitWorkbench.compare.viewList",
        "title": "%contributes.commands.33.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted && gitWorkbench.comparisonViewMode != list"
      },
      {
        "command": "gitWorkbench.compare.sort.name",
        "title": "%contributes.commands.34.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted && gitWorkbench.comparisonSortOrder != name"
      },
      {
        "command": "gitWorkbench.compare.sort.path",
        "title": "%contributes.commands.35.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted && gitWorkbench.comparisonSortOrder != path"
      },
      {
        "command": "gitWorkbench.compare.sort.status",
        "title": "%contributes.commands.36.title%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted && gitWorkbench.comparisonSortOrder != status"
      },
      {
        "command": "gitWorkbench.compare.close",
        "title": "%contributes.commands.37.title%",
        "category": "Git Workbench",
        "enablement": "gitWorkbench.comparisonActive"
      },
      {
        "command": "gitWorkbench.compare.icons.file",
        "title": "%comparison.icons.file%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted && gitWorkbench.comparisonIconStyle != file"
      },
      {
        "command": "gitWorkbench.compare.icons.status",
        "title": "%comparison.icons.status%",
        "category": "Git Workbench",
        "enablement": "isWorkspaceTrusted && gitWorkbench.comparisonIconStyle != status"
      }
    ],
    "submenus": [
      {
        "id": "gitWorkbench.editorMenu",
        "label": "Git Workbench"
      },
      {
        "id": "gitWorkbench.explorerMenu",
        "label": "Git Workbench"
      },
      {
        "id": "gitWorkbench.directoryMenu",
        "label": "Git Workbench"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "gitWorkbench.editorMenu",
          "when": "resourceScheme == file && isWorkspaceTrusted",
          "group": "gitWorkbench"
        }
      ],
      "explorer/context": [
        {
          "submenu": "gitWorkbench.explorerMenu",
          "when": "resourceScheme == file && !explorerResourceIsFolder && isWorkspaceTrusted",
          "group": "gitWorkbench"
        },
        {
          "submenu": "gitWorkbench.directoryMenu",
          "when": "resourceScheme == file && explorerResourceIsFolder && isWorkspaceTrusted",
          "group": "gitWorkbench"
        }
      ],
      "gitWorkbench.editorMenu": [
        {
          "command": "gitWorkbench.selectionHistory",
          "group": "1_history@1"
        },
        {
          "command": "gitWorkbench.fileHistory",
          "group": "1_history@2"
        },
        {
          "command": "gitWorkbench.blame",
          "group": "1_history@3"
        },
        {
          "command": "gitWorkbench.toggleBlame",
          "group": "1_history@4"
        },
        {
          "command": "gitWorkbench.stageSelection",
          "when": "editorHasSelection",
          "group": "2_commit"
        },
        {
          "command": "gitWorkbench.open",
          "group": "3_repository@1"
        },
        {
          "command": "gitWorkbench.operations",
          "group": "3_repository@2"
        }
      ],
      "gitWorkbench.explorerMenu": [
        {
          "command": "gitWorkbench.fileHistory",
          "group": "1_history"
        },
        {
          "command": "gitWorkbench.open",
          "group": "2_repository@1"
        },
        {
          "command": "gitWorkbench.operations",
          "group": "2_repository@2"
        }
      ],
      "commandPalette": [
        {
          "command": "gitWorkbench.menu",
          "when": "isWorkspaceTrusted"
        },
        {
          "command": "gitWorkbench.open",
          "when": "false"
        },
        {
          "command": "gitWorkbench.selectionHistory",
          "when": "false"
        },
        {
          "command": "gitWorkbench.fileHistory",
          "when": "false"
        },
        {
          "command": "gitWorkbench.blame",
          "when": "false"
        },
        {
          "command": "gitWorkbench.toggleBlame",
          "when": "false"
        },
        {
          "command": "gitWorkbench.operations",
          "when": "false"
        },
        {
          "command": "gitWorkbench.stageSelection",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.commit",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.add",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.exclude",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.diff",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.compareRevision",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.compareBranch",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.history",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.rollback",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.push",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.pull",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.fetch",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.merge",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.rebase",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.branches",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.newBranch",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.newTag",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.reset",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.stash",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.unstash",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.remotes",
          "when": "false"
        },
        {
          "command": "gitWorkbench.explorer.clone",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.refresh",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.search",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.select",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.viewTree",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.viewList",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.sort.name",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.sort.path",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.sort.status",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.close",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.icons.file",
          "when": "false"
        },
        {
          "command": "gitWorkbench.compare.icons.status",
          "when": "false"
        }
      ],
      "scm/title": [
        {
          "command": "gitWorkbench.open",
          "group": "navigation"
        }
      ],
      "gitWorkbench.directoryMenu": [
        {
          "command": "gitWorkbench.explorer.commit",
          "group": "1_commit@1"
        },
        {
          "command": "gitWorkbench.explorer.add",
          "group": "1_commit@2"
        },
        {
          "command": "gitWorkbench.explorer.exclude",
          "group": "1_commit@3"
        },
        {
          "command": "gitWorkbench.explorer.diff",
          "group": "2_history@1"
        },
        {
          "command": "gitWorkbench.explorer.compareRevision",
          "group": "2_history@2"
        },
        {
          "command": "gitWorkbench.explorer.compareBranch",
          "group": "2_history@3"
        },
        {
          "command": "gitWorkbench.explorer.history",
          "group": "2_history@4"
        },
        {
          "command": "gitWorkbench.explorer.rollback",
          "group": "2_history@5"
        },
        {
          "command": "gitWorkbench.explorer.push",
          "group": "3_sync@1"
        },
        {
          "command": "gitWorkbench.explorer.pull",
          "group": "3_sync@2"
        },
        {
          "command": "gitWorkbench.explorer.fetch",
          "group": "3_sync@3"
        },
        {
          "command": "gitWorkbench.explorer.merge",
          "group": "4_integrate@1"
        },
        {
          "command": "gitWorkbench.explorer.rebase",
          "group": "4_integrate@2"
        },
        {
          "command": "gitWorkbench.explorer.branches",
          "group": "5_refs@1"
        },
        {
          "command": "gitWorkbench.explorer.newBranch",
          "group": "5_refs@2"
        },
        {
          "command": "gitWorkbench.explorer.newTag",
          "group": "5_refs@3"
        },
        {
          "command": "gitWorkbench.explorer.reset",
          "group": "5_refs@4"
        },
        {
          "command": "gitWorkbench.explorer.stash",
          "group": "6_stash@1"
        },
        {
          "command": "gitWorkbench.explorer.unstash",
          "group": "6_stash@2"
        },
        {
          "command": "gitWorkbench.explorer.remotes",
          "group": "7_tools@1"
        },
        {
          "command": "gitWorkbench.explorer.clone",
          "group": "7_tools@2"
        }
      ],
      "view/title": [
        {
          "command": "gitWorkbench.compare.search",
          "when": "view == gitWorkbench.compareFiles",
          "group": "navigation@1"
        },
        {
          "command": "gitWorkbench.compare.refresh",
          "when": "view == gitWorkbench.compareFiles",
          "group": "navigation@2"
        },
        {
          "command": "gitWorkbench.compare.viewTree",
          "when": "view == gitWorkbench.compareFiles",
          "group": "1_view@1"
        },
        {
          "command": "gitWorkbench.compare.viewList",
          "when": "view == gitWorkbench.compareFiles",
          "group": "1_view@2"
        },
        {
          "command": "gitWorkbench.compare.sort.name",
          "when": "view == gitWorkbench.compareFiles",
          "group": "2_sort@1"
        },
        {
          "command": "gitWorkbench.compare.sort.path",
          "when": "view == gitWorkbench.compareFiles",
          "group": "2_sort@2"
        },
        {
          "command": "gitWorkbench.compare.sort.status",
          "when": "view == gitWorkbench.compareFiles",
          "group": "2_sort@3"
        },
        {
          "command": "gitWorkbench.compare.icons.file",
          "when": "view == gitWorkbench.compareFiles",
          "group": "2_icons@1"
        },
        {
          "command": "gitWorkbench.compare.icons.status",
          "when": "view == gitWorkbench.compareFiles",
          "group": "2_icons@2"
        },
        {
          "command": "gitWorkbench.compare.close",
          "when": "view == gitWorkbench.compareFiles",
          "group": "3_comparison@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gitWorkbench.open",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      }
    ],
    "viewsWelcome": [
      {
        "view": "gitWorkbench.compareFiles",
        "contents": "%contributes.viewsWelcome.0.contents%"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.7.0"
  }
}
